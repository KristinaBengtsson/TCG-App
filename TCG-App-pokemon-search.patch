+.coverage-note a, .login-link { color: #5040d8; }
+#search-status { min-height: 24px; margin-top: 28px; }
+.search-results { display: grid; grid-template-columns: repeat(auto-fill, minmax(175px, 1fr)); gap: 20px; }
+.search-card { padding: 16px; border: 1px solid #e1e5ef; border-radius: 14px; background: white; color: #172033; text-align: left; font: inherit; transition: box-shadow .15s; }
+.search-card:hover { box-shadow: 0 4px 20px #17203316; }
+.search-card h2 { font-size: 16px; margin: 14px 0 6px; }
+.search-card p { margin: 5px 0; font-size: 13px; color: #596579; overflow-wrap: anywhere; }
+.search-image { aspect-ratio: 245 / 337; display: flex; align-items: center; justify-content: center; background: #f6f8fc; border-radius: 9px; color: #596579; font-size: 14px; }
+.search-image img { width: 100%; height: 100%; object-fit: contain; }
+.search-pagination { display: flex; align-items: center; justify-content: center; gap: 20px; margin-top: 32px; }
+.card-search-page [hidden] { display: none; }
+#card-dialog { width: min(720px, calc(100% - 64px)); max-height: 85vh; overflow-y: auto; padding: 24px; border: 0; border-radius: 16px; color: #172033; }
+#card-dialog::backdrop { background: #17203399; }
+.dialog-close { float: right; }
+.card-detail-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; clear: both; }
+.card-detail-layout dl { margin: 0; }
+.card-detail-layout dt { color: #596579; font-size: 13px; margin-top: 14px; }
+.card-detail-layout dd { margin: 4px 0 0; overflow-wrap: anywhere; }
+@media (max-width: 760px) {
+    .card-search-page .sidebar { position: static; width: 100%; height: auto; display: flex; flex-wrap: wrap; gap: 6px; padding: 16px; }
+    .card-search-page .logo { width: 100%; margin-bottom: 8px; }
+    .card-search-page .menu-button { width: auto; margin: 0; }
+    .card-search-page .login-link { padding: 10px; }
+    .card-search-page .content { margin-left: 0; padding: 20px; }
+    .card-search-page .topbar { display: block; }
