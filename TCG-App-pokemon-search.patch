diff --git a/src/main/java/controllers/PokemonCardController.java b/src/main/java/controllers/PokemonCardController.java
new file mode 100644
index 0000000..3bcb7f3
--- /dev/null
+++ b/src/main/java/controllers/PokemonCardController.java
@@ -0,0 +1,65 @@
+package controllers;
+
+import io.javalin.config.JavalinConfig;
+import io.javalin.http.Context;
+import services.PokemonCardService;
+
+import java.io.IOException;
+import java.net.http.HttpTimeoutException;
+
+public class PokemonCardController {
+    public static void setRoutes(JavalinConfig config) {
+        setRoutes(config, new PokemonCardService());
+    }
+
+    public static void setRoutes(JavalinConfig config, PokemonCardService service) {
+        config.routes.get("/api/pokemon/cards", ctx -> respond(ctx, () -> {
+            String page = parameter(ctx, "page", "1");
+            if (!page.matches("[0-9]{1,5}")) {
+                throw new IllegalArgumentException("Ugyldigt sidenummer.");
+            }
+            return service.search(parameter(ctx, "language", "en"), ctx.queryParam("q"),
+                    parameter(ctx, "field", "name"), Integer.parseInt(page));
+        }));
+        config.routes.get("/api/pokemon/cards/{id}", ctx -> respond(ctx,
+                () -> service.card(parameter(ctx, "language", "en"), ctx.pathParam("id"))));
+    }
+
+    private static String parameter(Context ctx, String name, String fallback) {
+        String value = ctx.queryParam(name);
+        return value == null ? fallback : value;
+    }
+
+    private static void respond(Context ctx, ApiCall call) {
+        ctx.header("Cache-Control", "no-store");
+        try {
+            String json = call.execute();
+            ctx.header("Cache-Control", "private, max-age=300")
+                    .contentType("application/json; charset=utf-8").result(json);
+        } catch (IllegalArgumentException e) {
+            error(ctx, 400, e.getMessage());
+        } catch (HttpTimeoutException e) {
+            error(ctx, 504, "Kortdatabasen svarer for langsomt. Prøv igen.");
+        } catch (PokemonCardService.ApiException e) {
+            if (e.statusCode() == 404) {
+                error(ctx, 404, "Kortet blev ikke fundet på det valgte sprog.");
+            } else {
+                error(ctx, 502, "Kortdatabasen er midlertidigt utilgængelig. Prøv igen om lidt.");
+            }
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            error(ctx, 503, "Søgningen blev afbrudt. Prøv igen.");
+        } catch (IOException e) {
+            error(ctx, 502, "Kunne ikke hente kort fra kortdatabasen. Prøv igen.");
+        }
+    }
+
+    private static void error(Context ctx, int status, String message) {
+        ctx.status(status).contentType("text/plain; charset=utf-8").result(message);
+    }
+
+    @FunctionalInterface
+    private interface ApiCall {
+        String execute() throws IOException, InterruptedException;
+    }
+}
diff --git a/src/main/java/services/PokemonCardService.java b/src/main/java/services/PokemonCardService.java
new file mode 100644
index 0000000..f453d22
--- /dev/null
+++ b/src/main/java/services/PokemonCardService.java
@@ -0,0 +1,101 @@
+package services;
+
+import java.io.IOException;
+import java.net.URI;
+import java.net.URLEncoder;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.Set;
+
+/** Læser kort fra TCGdex. Ingen API-nøgle er nødvendig. */
+public class PokemonCardService {
+    public static final int PAGE_SIZE = 24;
+    private static final Set<String> LANGUAGES = Set.of(
+            "en", "fr", "es", "it", "pt", "pt-br", "pt-pt", "de", "nl", "pl", "ru",
+            "ja", "ko", "zh-tw", "zh-cn", "id", "th");
+    private final HttpClient client;
+    private final URI baseUri;
+    private final Duration timeout;
+
+    public PokemonCardService() {
+        this(HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(5)).build(),
+                URI.create("https://api.tcgdex.net/v2/"), Duration.ofSeconds(15));
+    }
+
+    // Gør det muligt at teste mod en lokal HTTP-server.
+    PokemonCardService(HttpClient client, URI baseUri, Duration timeout) {
+        this.client = client;
+        this.baseUri = baseUri;
+        this.timeout = timeout;
+    }
+
+    public String search(String language, String query, String field, int page)
+            throws IOException, InterruptedException {
+        validateLanguage(language);
+        if (!Set.of("name", "id", "localId", "set.name", "illustrator", "dexId").contains(field)) {
+            throw new IllegalArgumentException("Ugyldigt søgefelt.");
+        }
+        if (page < 1 || page > 10000) {
+            throw new IllegalArgumentException("Sidenummer skal være mellem 1 og 10000.");
+        }
+        String term = query == null ? "" : query.strip();
+        if (term.length() > 100) {
+            throw new IllegalArgumentException("Søgningen må højst være 100 tegn.");
+        }
+        if (field.equals("dexId") && !term.isEmpty() && !term.matches("[0-9]{1,4}")) {
+            throw new IllegalArgumentException("Pokédex-nummer skal være et tal på højst 4 cifre.");
+        }
+        String path = language + "/cards?pagination:page=" + page
+                + "&pagination:itemsPerPage=" + PAGE_SIZE + "&sort:field=id&sort:order=ASC";
+        if (!term.isEmpty()) {
+            // Et fast præfiks forhindrer, at fx 'not:' tolkes som en anden filtertype.
+            String filter = field.equals("dexId") ? "eq:" : "like:";
+            path += "&" + field + "=" + URLEncoder.encode(filter + term, StandardCharsets.UTF_8);
+        }
+        return get(path);
+    }
+
+    public String card(String language, String id) throws IOException, InterruptedException {
+        validateLanguage(language);
+        if (id == null || !id.matches("[A-Za-z0-9][A-Za-z0-9._-]{0,99}")) {
+            throw new IllegalArgumentException("Ugyldigt kort-ID.");
+        }
+        return get(language + "/cards/" + id);
+    }
+
+    private void validateLanguage(String language) {
+        if (language == null || !LANGUAGES.contains(language)) {
+            throw new IllegalArgumentException("Det valgte kortsprog understøttes ikke.");
+        }
+    }
+
+    private String get(String path) throws IOException, InterruptedException {
+        HttpRequest request = HttpRequest.newBuilder(baseUri.resolve(path))
+                .timeout(timeout).header("Accept", "application/json").GET().build();
+        HttpResponse<String> response = client.send(request,
+                HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        if (response.statusCode() != 200) {
+            throw new ApiException(response.statusCode());
+        }
+        if (!response.headers().firstValue("Content-Type").orElse("").contains("application/json")) {
+            throw new IOException("TCGdex returnerede ikke JSON.");
+        }
+        return response.body();
+    }
+
+    public static class ApiException extends IOException {
+        private final int statusCode;
+
+        public ApiException(int statusCode) {
+            super("TCGdex HTTP " + statusCode);
+            this.statusCode = statusCode;
+        }
+
+        public int statusCode() {
+            return statusCode;
+        }
+    }
+}
